# Copier ce fichier en `.env` et adapter les valeurs (le `.env` n'est PAS committé).

# --- PostgreSQL (compte admin, géré par l'image) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=fuelmix
POSTGRES_PORT=5432

# --- Rôles applicatifs (développement uniquement — surcharger en production) ---
FUELMIX_MIGRATOR_PASSWORD=migrator
FUELMIX_INGEST_PASSWORD=ingest
FUELMIX_REPORT_PASSWORD=report

# --- API ---
API_PORT=8080
FUELMIX_API_KEY=dev-api-key

# --- Ingestion ---
INGEST_INTERVAL_SECONDS=300
